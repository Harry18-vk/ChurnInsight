 <Worksheet ss:Name="Survey_Question_Guide">
  <Table ss:DefaultRowHeight="22">
   <Column ss:Width="130"/>
   <Column ss:Width="230"/>
   <Column ss:Width="230"/>
   <Column ss:Width="220"/>
   <Row ss:Height="28">
    <Cell ss:StyleID="GuideHeader"><Data ss:Type="String">Attribute Column</Data></Cell>
    <Cell ss:StyleID="GuideHeader"><Data ss:Type="String">Question to Ask Nearby People</Data></Cell>
    <Cell ss:StyleID="GuideHeader"><Data ss:Type="String">Valid Acceptable Values</Data></Cell>
    <Cell ss:StyleID="GuideHeader"><Data ss:Type="String">Explanation / Indian Context</Data></Cell>
   </Row>
   <Row><Cell ss:StyleID="DataCell"><Data ss:Type="String">customerID</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Person Name or ID tag</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Any unique text (e.g. SURVEY-01-Aman)</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Unique identifier for person</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataCell"><Data ss:Type="String">gender</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">What is their gender?</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Male, Female</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Gender of respondent</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataCell"><Data ss:Type="String">SeniorCitizen</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Are they aged 60 or above?</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">0 (No), 1 (Yes)</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">1 if elderly senior, else 0</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataCell"><Data ss:Type="String">Partner</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Are they married or living with partner?</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Yes, No</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Marital / partner status</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataCell"><Data ss:Type="String">Dependents</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Do they have children or elders dependent on them?</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Yes, No</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Family dependents</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataCell"><Data ss:Type="String">tenure</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">How many months have they used this SIM/Broadband?</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Integer (e.g. 1 to 72)</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">e.g. 6 months, 24 months</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataCell"><Data ss:Type="String">PhoneService</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Do they have calling service?</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Yes, No</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Usually Yes</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataCell"><Data ss:Type="String">MultipleLines</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Do they have multiple SIMs or family connections?</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Yes, No, No phone service</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Dual SIM / multi-line</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataCell"><Data ss:Type="String">InternetService</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">What type of internet connection do they have?</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Fiber optic, DSL, No</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">JioFiber/Airtel Xstream = Fiber optic</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataCell"><Data ss:Type="String">OnlineSecurity</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Do they have security/antivirus protection active?</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Yes, No, No internet service</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Cyber/malware security</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataCell"><Data ss:Type="String">OnlineBackup</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Do they use cloud backup (JioCloud/Google One)?</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Yes, No, No internet service</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Cloud storage bundle</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataCell"><Data ss:Type="String">DeviceProtection</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Do they have router or mobile damage protection?</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Yes, No, No internet service</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Device warranty plan</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataCell"><Data ss:Type="String">TechSupport</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Do they have priority VIP customer care?</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Yes, No, No internet service</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">High churn trigger if No</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataCell"><Data ss:Type="String">StreamingTV</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Do they watch live TV apps (JioTV, Airtel Xstream)?</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Yes, No, No internet service</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Live TV streaming</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataCell"><Data ss:Type="String">StreamingMovies</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Do they get OTT subscriptions (Netflix, Prime, Hotstar)?</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Yes, No, No internet service</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">OTT bundled recharge</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataCell"><Data ss:Type="String">Contract</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">How often do they recharge / commit?</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Month-to-month, One year, Two year</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Month-to-month = monthly recharge (Rank 1 churn driver)</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataCell"><Data ss:Type="String">PaperlessBilling</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Do they get bills online via SMS/Email/WhatsApp?</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Yes, No</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Digital bill alerts</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataCell"><Data ss:Type="String">PaymentMethod</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">How do they pay their recharge or bill?</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Electronic check, Mailed check, Bank transfer (automatic), Credit card (automatic)</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">UPI/Paytm/GPay = Electronic check; Auto-pay = Bank transfer (automatic)</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataCell"><Data ss:Type="String">MonthlyCharges</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">What is their monthly expense/bill (in ₹ or $)?</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Numeric (e.g. 299, 499, 799, 999)</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Average monthly expense</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataCell"><Data ss:Type="String">TotalCharges</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Total lifetime amount paid to provider</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Numeric (tenure * MonthlyCharges)</Data></Cell><Cell ss:StyleID="DataCell"><Data ss:Type="String">Can be left empty or calculated</Data></Cell></Row>
  </Table>
 </Worksheet>
</Workbook>
